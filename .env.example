# Project root is filled by scripts/env.sh or scripts/env.ps1.
TINYLEAN_ROOT=

# Kimina Lean Server
LEAN_SERVER_API_URL=http://127.0.0.1:8000
LEAN_SERVER_API_KEY=
LEAN_SERVER_PORT=8000

# Local model/data locations
TINYLEAN_MODEL_ROOT=
TINYLEAN_DATA_ROOT=

# Optional Hugging Face access token. Keep this only in .env, never in Git.
HF_TOKEN=

# Optional runtime controls
TINYLEAN_HTTP_TIMEOUT=60
TINYLEAN_MODEL_REVISION=main

